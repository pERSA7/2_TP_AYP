procedimiento exportar(E/S biblioteca: tArchivoBiblioteca; E/S destino: tTexto; E rutaBib, rutaCSV: cadena)
(*
    que hace: genera un archivo de texto CSV con todos los ejemplares (de alta y de baja), una linea por ejemplar
    pre: biblioteca = b, cerrado y ordenado por codigo
    post: el archivo rutaCSV contiene la cabecera y una linea por cada registro de b, en el mismo orden;
          en el campo ESTADO, A indica alta y B indica baja; biblioteca = b' = b
*)
Var
    reg: tLibro
    estado: cadena
Inicio
    abrir(biblioteca, rutaBib)
    crear(destino, rutaCSV)          // siempre se genera de nuevo
    escribirln(destino, "CODIGO,TITULO,AUTOR,FECHA,CANTIDAD,PRECIO,ESTADO")
    mientras no(esFinArchivo(biblioteca)) hacer
        leer(biblioteca, reg)
        si reg.disponible entonces
            estado <- "A"
        sino
            estado <- "B"
        fin si
        escribir(destino, concatena(enteroACadena(reg.codigo), ",", reg.titulo, ",", reg.autor, ",", enteroACadena(reg.fechaPublicacion.dia), "/", enteroACadena(reg.fechaPublicacion.mes), "/", enteroACadena(reg.fechaPublicacion.anio), ",", enteroACadena(reg.cantDisponible), ","))
        escribir(destino, reg.precio)
        escribirln(destino, concatena(",", estado))
    fin mientras
    cerrar(destino)
    cerrar(biblioteca)
Fin

procedure exportarCSV(var biblioteca:tArchivoBiblioteca; var nombreArchivo: text; RUTA_BIBLIOTECA, RUTA_EXPORTACION: string);
(*
    que hace: Exporta los datos de la biblioteca a un archivo de texto
    pre: biclioteca = b, bilbioteca debe venir abierto
    post: Biblioteca_Exportada = be    
*)
var
    aux: tLibro;
    estado: string;
begin
    assign(biblioteca, RUTA_BIBLIOTECA);
    reset(biblioteca);
    assign(nombreArchivo, RUTA_EXPORTACION);
    rewrite(nombreArchivo);
    writeln(nombreArchivo, 'codigo,titulo,autor,fechaPublicacion,cantDisponible,precio,disponible');
    while not(eof(biblioteca)) do
    begin
        read(biblioteca, aux);
        if aux.disponible then
            estado := 'A'
        else
            estado := 'B';
        write(nombreArchivo, aux.codigo, ',', aux.titulo, ',', aux.autor, ',', aux.fechaPublicacion.dia, '/', aux.fechaPublicacion.mes, '/', aux.fechaPublicacion.anio, ',', aux.cantDisponible, ',', aux.precio:0:2, ',', estado);
        write(nombreArchivo, aux.precio);
        writeln(nombreArchivo, ',', estado);
    end;
    close(biblioteca);
    close(nombreArchivo);
end;